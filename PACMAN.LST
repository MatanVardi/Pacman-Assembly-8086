    632
    633					 ; Check for top-left corner
    634	01A1  3B 06 1247r		 cmp ax, [wall_corner_radius]
    635	01A5  7F 21			 jg not_top_left_x
    636	01A7  3B 1E 1247r		 cmp bx, [wall_corner_radius]
    637	01AB  7F 1B			 jg not_top_left_y
    638
    639					 ; We're in the	top-left corner	region,	check if we should draw
    640					 ; (x^2	+ y^2 <= r^2)
    641	01AD  50			 push ax
    642	01AE  53			 push bx
    643
    644					 ; Calculate x^2
    645	01AF  F7 E0			 mul ax			; AX = x^2
    646	01B1  8B F0			 mov si, ax		; Save x^2 in SI
    647
    648					 ; Calculate y^2
    649	01B3  8B C3			 mov ax, bx
    650	01B5  F7 E0			 mul ax			; AX = y^2
    651
    652					 ; Calculate x^2 + y^2
    653	01B7  03 C6			 add ax, si		; AX = x^2 + y^2
    654
    655					 ; Calculate r^2
    656	01B9  8B 1E 1247r		 mov bx, [wall_corner_radius]
    657	01BD  F7 E3			 mul bx			; BX*BX	= r^2
    658
    659					 ; Compare
    660	01BF  3B C3			 cmp ax, bx
    661	01C1  5B			 pop bx
    662	01C2  58			 pop ax
    663	01C3  7F 0E			 jg skip_pixel		; If x^2 + y^2 > r^2, outside the radius
    664	01C5  EB 01 90			 jmp draw_normal_pixel
    665
