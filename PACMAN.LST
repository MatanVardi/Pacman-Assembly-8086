    606	0176  8B 16 053Br		 mov dx, y_pos		; Starting Y position
    607
    608					 ; Add inset to	create spacing between walls
    609	017A  03 0E 1249r		 add cx, [wall_inset_x]	; Add horizontal inset
    610	017E  03 16 124Br		 add dx, [wall_inset_y]	; Add vertical inset
