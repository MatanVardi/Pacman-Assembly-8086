    616	0187  8B 3E 124Dr		 mov di, [wall_width]	; Width	(X) counter
    617
    618	018B			     rect_col_loop:
    619					 ; Determine if	we need	to apply corner	rounding
    620					 ; Check if we're in a corner region
    621	018B  51			 push cx
    622	018C  52			 push dx
    623
    624					 ; Calculate position relative to rectangle start
    625	018D  8B C1			 mov ax, cx
